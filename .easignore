# Files EAS Build does not need. Without this the upload was 601 MB, because it
# included android/ (2.3 GB of local Gradle output) and node_modules (4.8 GB) —
# both of which EAS throws away and regenerates on its own builders.
#
# Lives at the repo root, not frontend/: EAS archives from the git root (the
# builder runs yarn in <archive>/frontend), so a copy inside frontend/ is never
# read. Patterns have no leading slash, so they match at any depth.
#
# Note this file REPLACES .gitignore for EAS uploads rather than adding to it,
# so anything that should stay out has to be listed here too.

# Installed fresh on the builder from yarn.lock
node_modules/

# Regenerated by prebuild from app.json; local copies carry Gradle output
android/
ios/

# Local caches and build artefacts
.expo/
.metro-cache/
dist/
web-build/
*.apk
*.aab
*.keystore

# Secrets — build-time values come from eas.json env instead
.env
.env.*.local

# Repo housekeeping that has no bearing on the build
.git/
.github/
docs/
test_reports/
tests/
memory/
.emergent/
*.log
