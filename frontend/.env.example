# Copy to .env and fill in from: Supabase Dashboard -> Project Settings -> API
#
# Both values are EXPO_PUBLIC_*, meaning Expo inlines them into the JS bundle at
# build time — anyone can read them out of a shipped APK. That is expected: the
# anon key is designed to be public, and Row Level Security (see
# supabase/schema.sql) is what actually protects the data.
#
# Never put the service_role key here. It bypasses RLS entirely.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key


# ---------------------------------------------------------------------------
# Gmail scanning (optional — the Scan Gmail screen hides itself without these)
#
# Create these in Google Cloud Console -> APIs & Services -> Credentials. One
# OAuth client per platform, because Google validates the redirect against the
# client *type*. Full walkthrough: docs/gmail-setup.md
#
# These are client ids, not secrets — the flow uses PKCE, so no client secret is
# ever needed or shipped.
# ---------------------------------------------------------------------------

# Client type "Android", package name com.suborganizer.app + your signing SHA-1
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Client type "iOS", bundle id com.suborganizer.app
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional — only for the development build, which runs under a separate package
# name so it can sit alongside the Play install. Google keys an Android client to
# a package name, so the dev variant needs its own client:
# type "Android", package name com.suborganizer.app.dev, same SHA-1.
# Leave blank and Gmail scanning simply reports itself unavailable in the dev
# build; everything else works.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID_DEV=
