# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules/

# IDE and editors
.idea/
.vscode/

# Secrets.
#
# `frontend/.env.example` is the checked-in template the README tells you to copy
# from, so it is re-included — the broad `.env.*` above was swallowing it, which
# left a fresh clone with nothing to copy.
.env
.env.*
*.env
!frontend/.env.example
credentials.json
*credentials.json*
*token.json*
*.key
.credentials
*.pem

# Signing material. A leaked upload key cannot be rotated on a published app.
*.jks
*.keystore
*.p8
*.p12

# Build output and caches
dist/
/build
.cache/
*.tsbuildinfo

# EAS build artefacts, downloaded next to the project
release/
*.aab
*.apk

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# npm lockfile — EAS builds from yarn.lock, and two lockfiles drift apart
frontend/package-lock.json

# Supabase CLI local state
supabase/.temp/

# macOS
.DS_Store
